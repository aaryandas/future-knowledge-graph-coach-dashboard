# Required. Neo4j holds the Movement/Clinical Graph and Member Context Graph.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=coach-password
NEO4J_DATABASE=neo4j

# Required. Postgres holds LangGraph threads and checkpoints.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coach

# Required. OpenRouter API key for LLM and embedding calls.
OPENROUTER_API_KEY=

# Optional. Overrides the default chat model (DeepSeek v4 flash).
OPENROUTER_MODEL=

# Optional. Set both to send traces to LangSmith. Tracing is off when empty.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
